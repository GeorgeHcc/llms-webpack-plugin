{
  "name": "webpack-plugin-llms",
  "version": "1.0.0",
  "description": "a webpack plugin for llms",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webpack-plugin",
    "llms",
    "markdown"
  ],
  "author": "George Hcc",
  "license": "ISC",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saschaseniuk/vite-plugin-llms.git"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/webpack": "^5.28.5",
    "@types/webpack-sources": "^3.2.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
