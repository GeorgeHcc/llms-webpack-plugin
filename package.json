{
  "name": "webpack-plugin-llms",
  "version": "1.0.0",
  "description": "Webpack plugin for llms.txt specification support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webpack-plugin",
    "llms",
    "markdown"
  ],
  "author": "George Hcc",
  "license": "MIT",
  "homepage": "https://github.com/GeorgeHcc/webpack-plugin-llms#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeorgeHcc/webpack-plugin-llms"
  },
  "peerDependencies": {
    "webpack": "^5.0.0",
    "webpack-sources": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": false
    },
    "webpack-sources": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/webpack": "^5.28.5",
    "@types/webpack-sources": "^3.2.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
